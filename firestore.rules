/**
 * Core Philosophy: This ruleset enforces a "Public Read, Admin Write" security model.
 * All website content, such as training courses, categories, and media, is publicly
 * readable by any user, including unauthenticated visitors. However, all write
 * operations (creating, updating, or deleting content) are strictly reserved for
 * authenticated users who are designated as administrators.
 *
 * Data Structure: The data is organized into flat, top-level collections, such as
 * /trainingCourses and /mediaAssets. This structure promotes performance and simplifies
 * security rules by avoiding complex hierarchical dependencies.
 *
 * Key Security Decisions:
 * - Admin Role Management: Administrator privileges are managed directly in Firestore
 *   within the `/roles_admin/{adminUid}` collection. A user is considered an admin if a
 *   document with their UID exists in this collection and has `isAdmin: true`. This
 *   approach avoids reliance on custom claims and allows for dynamic role management.
 * - Default Posture: All write access is denied by default. Permissions are explicitly
 *   granted only to administrators. There are no user-owned data collections.
 *
 * Denormalization for Authorization: The primary denormalization strategy is the
 * `/roles_admin` collection, which serves as a centralized lookup for admin status.
 * This allows any other rule in the system to perform a simple, fast check
 * to determine if the requesting user has administrative rights.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    
    /**
     * Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the user has an admin role. This is a robust check that
     * first ensures the role document exists, then checks if its `isAdmin` flag is true.
     * This prevents errors if the rule is checked before the document is created.
     */
    function isAdmin() {
      return isSignedIn() 
        && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid))
        && get(/databases/$(database)/documents/roles_admin/$(request.auth.uid)).data.isAdmin == true;
    }
    
    /**
     * A check for update/delete operations, ensuring the user is an admin
     * and the document they are trying to modify already exists.
     */
    function isExistingDocAdmin() {
        return isAdmin() && resource != null;
    }

    /**
     * @description Publicly readable training category data. Only admins can modify.
     */
    match /trainingCategories/{categoryId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update, delete: if isExistingDocAdmin();
    }

    /**
     * @description Publicly readable training course data. Only admins can modify.
     */
    match /trainingCourses/{courseId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update, delete: if isExistingDocAdmin();
    }

    /**
     * @description Metadata for media assets (images, videos). Publicly readable. Only admins can modify.
     */
    match /mediaAssets/{mediaId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    /**
     * @description Singleton collection for homepage content. Publicly readable. Only admins can modify.
     */
    match /homepageContent/{contentId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update, delete: if isExistingDocAdmin();
    }

    /**
     * @description Contact form submissions. Publicly writeable, admin readable.
     */
    match /contactSubmissions/{submissionId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    /**
     * @description Manages administrator roles. Only existing admins can read or write to this collection.
     */
    match /roles_admin/{adminUid} {
      // Allow any signed-in user to read an admin role doc. This is required for
      // cross-service security rules (like from Storage) to be able to check for admin status.
      // The document itself contains no sensitive data.
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create, update, delete: if isSignedIn() && request.auth.uid == adminUid;
    }
  }
}
