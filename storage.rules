rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    /**
     * @description Helper function to check for admin role from Firestore.
     * This demonstrates a cross-service security rule.
     */
    function isAdmin() {
      return request.auth != null &&
             exists(/databases/(default)/documents/roles_admin/$(request.auth.uid)) &&
             get(/databases/(default)/documents/roles_admin/$(request.auth.uid)).data.isAdmin == true;
    }

    /**
     * @description Media assets are publicly readable for website display.
     * Only authenticated admins are allowed to upload, update, or delete files.
     */
    match /mediaAssets/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
