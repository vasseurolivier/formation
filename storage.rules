rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    /**
     * @description Media assets are publicly readable for website display.
     * Any authenticated user (i.e., anyone who can access the admin panel)
     * is allowed to write. The security is enforced by Firestore rules, which
     * only allow admins to create the corresponding mediaAsset document,
     * making non-admin uploads orphaned and unused.
     */
    match /mediaAssets/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
